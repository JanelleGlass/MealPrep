@page "/recipes"
@using MealPrep.Data
@using MealPrep.Services
@inject RecipeService RecipeService
@inject RecipeBookService BookService
@inject IngredientService IngredientService
@inject IJSRuntime JS
<PageTitle>Recipes</PageTitle>

<div class="container-fluid py-3">
    @if (selectedBook == null)
    {
        @* ===== Level 1: Book List ===== *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 text-primary fw-bold">📖 Recipes</h2>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary" @onclick="StartAddBook">+ New Book</button>
                <button class="btn btn-primary" @onclick="StartAdd">+ New Recipe</button>
            </div>
        </div>

        <div class="mb-3">
            <input type="text" class="form-control" placeholder="🔍 Search recipes..." @bind="searchTerm" @bind:event="oninput" />
        </div>

        @if (books == null)
        {
            <p class="text-muted">Loading...</p>
        }
        else
        {
            @if (books.Any())
            {
                var filteredBooks = books.Where(b => string.IsNullOrWhiteSpace(searchTerm) || b.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
                @if (filteredBooks.Any())
                {
                <h5 class="fw-bold mb-3">📚 Recipe Books</h5>
                <div class="row g-3 mb-4">
                    @foreach (var book in filteredBooks)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm h-100 book-card" title="Click to open book" @onclick="() => SelectBook(book.Id)">
                                <div class="card-body d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="card-title">@book.Name</h5>
                                        @if (!string.IsNullOrEmpty(book.Description))
                                        {
                                            <p class="card-text text-muted small">
                                                @(book.Description.Length > 100 ? book.Description.Substring(0, 100) + "…" : book.Description)
                                            </p>
                                        }
                                        <span class="badge bg-primary">🧾 @book.Entries.Count recipe@(book.Entries.Count != 1 ? "s" : "")</span>
                                    </div>
                                    <span class="text-muted fs-4">›</span>
                                </div>
                                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center" @onclick:stopPropagation="true">
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditBook(book)">✏️ Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBook(book.Id)">🗑️ Delete</button>
                                    </div>
                                    <a href="javascript:void(0)" class="text-primary fw-semibold text-decoration-none" @onclick="() => SelectBook(book.Id)">View Recipes →</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                }
            }

            @if (ungroupedRecipes != null && ungroupedRecipes.Any())
            {
                var filteredUngrouped = ungroupedRecipes.Where(r => string.IsNullOrWhiteSpace(searchTerm) || r.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
                @if (filteredUngrouped.Any())
                {
                <h5 class="fw-bold mb-3">Ungrouped Recipes</h5>
                <div class="row g-3">
                    @foreach (var recipe in filteredUngrouped)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">@recipe.Name</h5>
                                    <span class="badge bg-primary mb-2">👥 @recipe.Servings serving@(recipe.Servings != 1 ? "s" : "")</span>
                                    @{ var ungroupedCost = GetRecipeCost(recipe); }
                                    @if (!string.IsNullOrEmpty(ungroupedCost))
                                    {
                                        <span class="badge bg-success mb-2">💰 @ungroupedCost</span>
                                    }
                                    @if (!string.IsNullOrEmpty(recipe.Description))
                                    {
                                        <p class="card-text text-muted small">
                                            @(recipe.Description.Length > 100 ? recipe.Description.Substring(0, 100) + "…" : recipe.Description)
                                        </p>
                                    }
                                    @if (recipe.Ingredients.Any())
                                    {
                                        <span class="badge bg-light text-dark" title="@string.Join("&#10;", recipe.Ingredients.Select(i => $"{i.Quantity} {i.Ingredient?.Unit} {i.Ingredient?.Name}"))">
                                            🧾 @recipe.Ingredients.Count ingredient@(recipe.Ingredients.Count != 1 ? "s" : "")
                                        </span>
                                    }
                                </div>
                                <div class="card-footer bg-transparent border-0 d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(recipe)">✏️ Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(recipe.Id)">🗑️ Delete</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                }
            }

            @if (!books.Any() && (ungroupedRecipes == null || !ungroupedRecipes.Any()))
            {
                <div class="alert alert-info">No recipes or books yet. Create a recipe book or recipe to get started!</div>
            }
        }
    }
    else
    {
        @* ===== Level 2: Book Detail ===== *@
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0)" @onclick="BackToBooks" style="text-decoration:none;">📖 Recipes</a></li>
                <li class="breadcrumb-item active" aria-current="page">@selectedBook.Name</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-1 text-primary fw-bold">@selectedBook.Name</h3>
                @if (!string.IsNullOrEmpty(selectedBook.Description))
                {
                    <p class="text-muted mb-0">@selectedBook.Description</p>
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm" @onclick="ShowAddRecipeToBook">+ Add Existing Recipe</button>
                <button class="btn btn-primary btn-sm" @onclick="StartAddToBook">+ New Recipe</button>
            </div>
        </div>

        @if (!selectedBook.Entries.Any())
        {
            <div class="alert alert-info">This book has no recipes yet. Add or create recipes to get started!</div>
        }
        else
        {
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="🔍 Search recipes..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th role="button" @onclick='() => SetSort("Name")'>Name @SortIndicator("Name")</th>
                            <th role="button" @onclick='() => SetSort("Servings")'>Servings @SortIndicator("Servings")</th>
                            <th>Ingredients</th>
                            <th role="button" @onclick='() => SetSort("Cost")'>Cost @SortIndicator("Cost")</th>
                            <th>Description</th>
                            <th style="width:180px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in GetFilteredSortedEntries())
                        {
                            var recipe = entry.Recipe;
                            if (recipe == null) continue;
                            <tr>
                                <td class="fw-bold">@recipe.Name</td>
                                <td><span class="badge bg-primary">👥 @recipe.Servings</span></td>
                                <td>
                                    @if (recipe.Ingredients.Any())
                                    {
                                        <span class="badge bg-light text-dark" title="@string.Join("&#10;", recipe.Ingredients.Select(i => $"{i.Quantity} {i.Ingredient?.Unit} {i.Ingredient?.Name}"))">
                                            🧾 @recipe.Ingredients.Count
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{ var bookRecipeCost = GetRecipeCost(recipe); }
                                    @if (!string.IsNullOrEmpty(bookRecipeCost))
                                    {
                                        <span class="badge bg-success">💰 @bookRecipeCost</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @if (!string.IsNullOrEmpty(recipe.Description))
                                    {
                                        @(recipe.Description.Length > 60 ? recipe.Description.Substring(0, 60) + "…" : recipe.Description)
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(recipe)">✏️ Edit</button>
                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => RemoveFromBook(entry.RecipeId)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@* ===== Recipe Edit/Add Modal ===== *@
@if (showForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(editingRecipe.Id == 0 ? "New Recipe" : "Edit Recipe")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Recipe Name</label>
                        <input @bind="editingRecipe.Name" class="form-control" placeholder="e.g., Chicken Stir Fry" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description (optional)</label>
                        <textarea @bind="editingRecipe.Description" class="form-control" rows="2"
                                  placeholder="Cooking instructions, notes..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Servings</label>
                        <input @bind="editingRecipe.Servings" type="number" min="1" class="form-control" />
                        <small class="form-text text-muted">How many people does this recipe serve?</small>
                    </div>
                    @if (editingRecipe.Id == 0 && books != null && books.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Add to Book (optional)</label>
                            <select @bind="selectedBookIdForNewRecipe" class="form-select">
                                <option value="0">-- No book --</option>
                                @foreach (var book in books)
                                {
                                    <option value="@book.Id">@book.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <h6 class="fw-bold mt-4 mb-2">Ingredients</h6>
                    @if (!allIngredients.Any())
                    {
                        <div class="alert alert-warning small py-2">No ingredients defined yet. <a href="/ingredients">Add ingredients first.</a></div>
                    }
                    @for (int i = 0; i < editingIngredients.Count; i++)
                    {
                        var idx = i;
                        var rowIng = allIngredients.FirstOrDefault(ii => ii.Id == editingIngredients[idx].IngredientId);
                        var linePrice = rowIng?.PricePerUnit != null
                            ? currencySymbol + (editingIngredients[idx].Quantity * rowIng.PricePerUnit.Value).ToString("F2")
                            : "—";
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-md-5">
                                <select @bind="editingIngredients[idx].IngredientId" class="form-select form-select-sm">
                                    <option value="0">-- Select ingredient --</option>
                                    @foreach (var ing in allIngredients)
                                    {
                                        <option value="@ing.Id">@ing.Name (@ing.Unit)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input @bind="editingIngredients[idx].Quantity" type="number" step="0.01"
                                       class="form-control form-control-sm" placeholder="Qty" />
                            </div>
                            <div class="col-md-3">
                                <span class="form-control-plaintext form-control-sm text-muted">@linePrice</span>
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveIngredient(idx)">✕</button>
                            </div>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-success mt-1" @onclick="AddIngredient">+ Add Ingredient</button>
                    @{
                        decimal editTotal = 0;
                        bool editHasPrice = false;
                        foreach (var ei in editingIngredients)
                        {
                            var ing = allIngredients.FirstOrDefault(i => i.Id == ei.IngredientId);
                            if (ing?.PricePerUnit != null)
                            {
                                editTotal += ei.Quantity * ing.PricePerUnit.Value;
                                editHasPrice = true;
                            }
                        }
                    }
                    @if (editHasPrice)
                    {
                        <div class="mt-2 fw-bold text-success">Estimated Cost: @currencySymbol@editTotal.ToString("F2")</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    <button class="btn btn-success" @onclick="Save">💾 Save Recipe</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Book Edit/Add Modal ===== *@
@if (showBookForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(editingBook.Id == 0 ? "New Recipe Book" : "Edit Recipe Book")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelBook"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Book Name</label>
                        <input @bind="editingBook.Name" class="form-control" placeholder="e.g., Janelle's Recipes" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description (optional)</label>
                        <textarea @bind="editingBook.Description" class="form-control" rows="2"
                                  placeholder="A short description of this book..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelBook">Cancel</button>
                    <button class="btn btn-success" @onclick="SaveBook">💾 Save Book</button>
                </div>
            </div>
        </div>
    </div>
}

@* ===== Add Existing Recipe to Book Modal ===== *@
@if (showAddToBookPicker)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Add Recipe to @selectedBook?.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showAddToBookPicker = false"></button>
                </div>
                <div class="modal-body">
                    @if (availableRecipes != null && availableRecipes.Any())
                    {
                        <div class="list-group">
                            @foreach (var recipe in availableRecipes)
                            {
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                        @onclick="() => AddExistingRecipeToBook(recipe.Id)">
                                    @recipe.Name
                                    <span class="badge bg-primary">👥 @recipe.Servings</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No available recipes to add. All recipes are already in this book.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showAddToBookPicker = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .book-card {
        cursor: pointer;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .book-card:hover {
        border-color: var(--bs-primary);
        box-shadow: 0 0.25rem 0.75rem rgba(13, 110, 253, 0.15);
    }
</style>

@code {
    private List<RecipeBook>? books;
    private List<Recipe>? ungroupedRecipes;
    private RecipeBook? selectedBook;
    private List<Ingredient> allIngredients = new();
    private string currencySymbol = "$";
    private string searchTerm = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;

    // Recipe form state
    private bool showForm;
    private Recipe editingRecipe = new();
    private List<RecipeIngredient> editingIngredients = new();
    private bool addingToBook; // true when creating a new recipe that should be added to the selected book
    private int selectedBookIdForNewRecipe; // book to add the new recipe to (0 = none)

    // Book form state
    private bool showBookForm;
    private RecipeBook editingBook = new();

    // Add existing recipe to book picker
    private bool showAddToBookPicker;
    private List<Recipe>? availableRecipes;

    protected override async Task OnInitializedAsync()
    {
        allIngredients = await IngredientService.GetAllAsync();
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currencySymbol = await JS.InvokeAsync<string>("currencySymbol.get");
            StateHasChanged();
        }
    }

    private string GetRecipeCost(Recipe recipe)
    {
        decimal total = 0;
        bool hasPrice = false;
        foreach (var ri in recipe.Ingredients)
        {
            var ing = ri.Ingredient ?? allIngredients.FirstOrDefault(i => i.Id == ri.IngredientId);
            if (ing?.PricePerUnit != null)
            {
                total += ri.Quantity * ing.PricePerUnit.Value;
                hasPrice = true;
            }
        }
        return hasPrice ? $"{currencySymbol}{total:F2}" : "";
    }

    private async Task LoadData()
    {
        books = await BookService.GetAllBooksAsync();
        ungroupedRecipes = await BookService.GetUngroupedRecipesAsync();
        if (selectedBook != null)
        {
            selectedBook = await BookService.GetBookWithRecipesAsync(selectedBook.Id);
        }
    }

    // ===== Book CRUD =====

    private void StartAddBook()
    {
        editingBook = new RecipeBook();
        showBookForm = true;
    }

    private void StartEditBook(RecipeBook book)
    {
        editingBook = new RecipeBook { Id = book.Id, Name = book.Name, Description = book.Description };
        showBookForm = true;
    }

    private async Task SaveBook()
    {
        if (string.IsNullOrWhiteSpace(editingBook.Name)) return;
        if (editingBook.Id == 0)
        {
            await BookService.CreateBookAsync(editingBook.Name, editingBook.Description);
        }
        else
        {
            await BookService.UpdateBookAsync(editingBook);
        }
        showBookForm = false;
        await LoadData();
    }

    private void CancelBook() => showBookForm = false;

    private async Task DeleteBook(int id)
    {
        await BookService.DeleteBookAsync(id);
        await LoadData();
    }

    // ===== Book navigation =====

    private async Task SelectBook(int bookId)
    {
        searchTerm = "";
        sortColumn = "Name";
        sortAscending = true;
        selectedBook = await BookService.GetBookWithRecipesAsync(bookId);
    }

    private async Task BackToBooks()
    {
        searchTerm = "";
        sortColumn = "Name";
        sortAscending = true;
        selectedBook = null;
        await LoadData();
    }

    // ===== Add/remove recipes in book =====

    private async Task ShowAddRecipeToBook()
    {
        if (selectedBook == null) return;
        var allRecipes = await RecipeService.GetAllRecipesAsync();
        var bookRecipeIds = selectedBook.Entries.Select(e => e.RecipeId).ToHashSet();
        availableRecipes = allRecipes.Where(r => !bookRecipeIds.Contains(r.Id)).ToList();
        showAddToBookPicker = true;
    }

    private async Task AddExistingRecipeToBook(int recipeId)
    {
        if (selectedBook == null) return;
        await BookService.AddRecipeToBookAsync(selectedBook.Id, recipeId);
        selectedBook = await BookService.GetBookWithRecipesAsync(selectedBook.Id);
        var bookRecipeIds = selectedBook!.Entries.Select(e => e.RecipeId).ToHashSet();
        availableRecipes = availableRecipes?.Where(r => !bookRecipeIds.Contains(r.Id)).ToList();
        if (availableRecipes != null && !availableRecipes.Any())
            showAddToBookPicker = false;
    }

    private async Task RemoveFromBook(int recipeId)
    {
        if (selectedBook == null) return;
        await BookService.RemoveRecipeFromBookAsync(selectedBook.Id, recipeId);
        selectedBook = await BookService.GetBookWithRecipesAsync(selectedBook.Id);
    }

    private void StartAddToBook()
    {
        addingToBook = true;
        StartAddInternal();
    }

    // ===== Recipe CRUD =====

    private async Task StartAdd()
    {
        addingToBook = false;
        selectedBookIdForNewRecipe = 0;
        allIngredients = await IngredientService.GetAllAsync();
        editingRecipe = new Recipe();
        editingIngredients = new List<RecipeIngredient> { new() };
        showForm = true;
    }

    private void StartAddInternal()
    {
        selectedBookIdForNewRecipe = selectedBook?.Id ?? 0;
        editingRecipe = new Recipe();
        editingIngredients = new List<RecipeIngredient> { new() };
        showForm = true;
    }

    private async Task StartEdit(Recipe recipe)
    {
        addingToBook = false;
        allIngredients = await IngredientService.GetAllAsync();
        editingRecipe = new Recipe
        {
            Id = recipe.Id,
            Name = recipe.Name,
            Description = recipe.Description,
            Servings = recipe.Servings
        };
        editingIngredients = recipe.Ingredients.Select(i => new RecipeIngredient
        {
            Id = i.Id,
            IngredientId = i.IngredientId,
            Quantity = i.Quantity,
            RecipeId = i.RecipeId
        }).ToList();
        if (!editingIngredients.Any()) editingIngredients.Add(new());
        showForm = true;
    }

    private void AddIngredient() => editingIngredients.Add(new());

    private void RemoveIngredient(int idx)
    {
        if (editingIngredients.Count > 1)
            editingIngredients.RemoveAt(idx);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editingRecipe.Name)) return;

        var validIngredients = editingIngredients
            .Where(i => i.IngredientId > 0)
            .ToList();

        if (editingRecipe.Id == 0)
        {
            editingRecipe.Ingredients = validIngredients;
            var created = await RecipeService.CreateRecipeAsync(editingRecipe);

            // Add to the selected book (chosen via dropdown or from book detail context)
            int targetBookId = selectedBookIdForNewRecipe;
            if (targetBookId == 0 && addingToBook && selectedBook != null)
                targetBookId = selectedBook.Id;
            if (targetBookId > 0)
            {
                await BookService.AddRecipeToBookAsync(targetBookId, created.Id);
            }
        }
        else
        {
            await RecipeService.UpdateRecipeAsync(editingRecipe, validIngredients);
        }

        showForm = false;
        addingToBook = false;
        await LoadData();
    }

    private async Task Delete(int id)
    {
        await RecipeService.DeleteRecipeAsync(id);
        await LoadData();
    }

    private void Cancel()
    {
        showForm = false;
        addingToBook = false;
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string SortIndicator(string column)
        => sortColumn == column ? (sortAscending ? " ▲" : " ▼") : "";

    private decimal GetRecipeCostValue(Recipe? recipe)
    {
        if (recipe == null) return 0;
        decimal total = 0;
        foreach (var ri in recipe.Ingredients)
        {
            var ing = ri.Ingredient ?? allIngredients.FirstOrDefault(i => i.Id == ri.IngredientId);
            if (ing?.PricePerUnit != null)
                total += ri.Quantity * ing.PricePerUnit.Value;
        }
        return total;
    }

    private IEnumerable<RecipeBookEntry> GetFilteredSortedEntries()
    {
        var result = selectedBook!.Entries.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
            result = result.Where(e => e.Recipe != null && e.Recipe.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        result = sortColumn switch
        {
            "Servings" => sortAscending ? result.OrderBy(e => e.Recipe?.Servings ?? 0) : result.OrderByDescending(e => e.Recipe?.Servings ?? 0),
            "Cost" => sortAscending
                ? result.OrderBy(e => GetRecipeCostValue(e.Recipe))
                : result.OrderByDescending(e => GetRecipeCostValue(e.Recipe)),
            _ => sortAscending ? result.OrderBy(e => e.Recipe?.Name) : result.OrderByDescending(e => e.Recipe?.Name),
        };
        return result;
    }
}
